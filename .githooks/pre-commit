#!/usr/bin/env sh
set -eu
ROOT="$(git rev-parse --show-toplevel)"
if command -v python3 >/dev/null 2>&1; then
  exec python3 "$ROOT/tool/git_hooks.py" pre-commit "$@"
elif command -v python >/dev/null 2>&1; then
  exec python "$ROOT/tool/git_hooks.py" pre-commit "$@"
else
  echo "[git-hook] ERROR: python3/python not found in PATH; cannot run pre-commit checks." >&2
  exit 1
fi
